# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your private configurations.
# NOTE: Never commit your actual '.env' file containing real secrets to Git.

# --- Storage & Directory Paths ---
# Local or mounted cloud directory containing datasets and outputs
BASE_DIR="./data"
IMAGES_DIR="./data/images"
CAPTIONS_FILE="./data/captions.txt"
WORKING_DIR="./working"

# --- Optional: Kaggle API Credentials (if downloading dataset via Kaggle CLI) ---
# Obtain from your Kaggle Account Settings -> 'Create New Token' (kaggle.json)
KAGGLE_USERNAME="your_kaggle_username"
KAGGLE_KEY="your_kaggle_api_key"

# --- Optional: Model Hyperparameters ---
BATCH_SIZE=32
EPOCHS=20
MAX_SEQUENCE_LENGTH=35
VOCAB_SIZE=8353
